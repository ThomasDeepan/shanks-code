# ==============================================================================
# Shank's Code Frontend Environment Configuration
# ==============================================================================

# API Execution Mode:
# - 'mock': Uses in-memory typed development datasets with simulated latency.
# - 'live': Dispatches HTTP requests to VITE_API_BASE_URL (zero silent fallback).
VITE_API_MODE=mock

# Base URL for Node.js / Express REST API in live mode.
# Components and services DO NOT hardcode localhost URLs.
VITE_API_BASE_URL=http://localhost:5000/api
